SUPABASE_URL=

SUPABASE_API_KEY=
SUPABASE_JWKS_URL=

SUPABASE_JWT_ALGORITHM=ES256

VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=
VNPAY_RETURN_URL=


LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
LALAMOVE_BASE_URL=
LALAMOVE_MARKET=

# AllinGo (used when admin_settings delivery_provider_allingo = 1). Test keys on DEV, live keys on PROD.
ALLINGO_APP_ID=
ALLINGO_APP_SECRET=
ALLINGO_WEBHOOK_SECRET=
# Default https://pro.allingo.vn/api/v1 and "grab,lalamove,gsm"; DEV test keys only see "simulator".
ALLINGO_BASE_URL=
ALLINGO_PARTNER_IDS=

GOONG_API_KEY=

MOIT_API_USERNAME=
MOIT_API_PASSWORD=

# Cloudflare Turnstile secret for the public /join form. Local: Cloudflare test secret 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

CORS_EXTRA_ORIGIN=

# Web Push (VAPID). Public key goes to frontend VITE_VAPID_PUBLIC_KEY.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@sariko.store

# New-complaint email to support (docs/dev/complaint-email). Empty SMTP_PASSWORD or COMPLAINT_EMAIL_TO = no email (DEV default).
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=support@sariko.store
SMTP_PASSWORD=
COMPLAINT_EMAIL_TO=
ADMIN_APP_URL=https://admin.sariko.store

# Ops messages to the team's Zalo groups (docs/dev/zalo-alerts). No token or no chat id for a kind = not sent (local default).
# DEV: every ZALO_CHAT_* = the test chat id, never the team groups; PROD: the Ops Hub group id.
ZALO_BOT_TOKEN=
ZALO_CHAT_ORDERS=
ZALO_CHAT_SUPPORT=
ZALO_CHAT_OPS=

# Healthchecks.io ping key of the project (docs/dev/20261106-job-control QD 8): each background job pings <ENV>-job-<job>.
# Empty = no pings (local default).
HC_PING_KEY=

# Admin Gateway (T176): the admin backend sends this in X-Api-Key (its SARIKO_APP_GATEWAY_KEY). Empty = gateway off.
ADMIN_GATEWAY_API_KEY=

# Background jobs (order expiry, payment check, API metrics, delivery wallet) are off when ENV is local: they would
# compete with the DEV server on the DEV database. 1 = run them on this machine.
RUN_JOBS=0
