# Copy to .env.development (local) or .env.production (build).
# All frontend vars MUST be prefixed VITE_ to be exposed by Vite.

# Supabase project — anon key only, never the service role key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend base path. Leave as /rest in dev (Vite proxies /rest -> localhost:5000)
VITE_API_BASE_URL=/rest

# Zen partnership cross-promo placement: "banner" | "floating" | "none"
VITE_ZEN_AD_VARIANT=none
# Bump to re-show the banner to users who dismissed it (default "1")
VITE_ZEN_BANNER_VERSION=
# Link opened when the Zen promo is clicked
VITE_ZEN_URL=

# Web Push — public half of the backend VAPID_PRIVATE_KEY pair
VITE_VAPID_PUBLIC_KEY=

# Dev panel (Ctrl+Shift+Q): "true" on local + DEV only, unset on PROD
VITE_DEV_PANEL=

# Cloudflare Turnstile site key for the public /join form. Local: Cloudflare test key 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
